# ApnaVaidya Environment Configuration

# Frontend Backend Connection (leave empty for auto-discovery on localhost:8080 / 8081)
VITE_API_URL=

# Backend Cryptographic JWT Secret (Change to a strong 256-bit random key in production)
JWT_SECRET=ApnaVaidya_2026_Enterprise_Production_Secret_Key_98234!

# Phase 6 AES-256 GCM Cryptographic Vault Key (Change to a strong 256-bit random key in production)
VAULT_ENCRYPTION_KEY=ApnaVaidya_2026_Enterprise_AES256_Vault_Key_Production_98234!

# Phase 4 Relational Database URL (Optional: JDBC URL e.g. jdbc:postgresql://localhost:5432/apnavaidya or jdbc:sqlite:server/data/apnavaidya.db)
DATABASE_URL=

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://apnavaidya.vercel.app,https://apnavaidya.onrender.com

# Phase 3 LLM Gateways (Optional: If unset, automatically uses local dynamic Indian Clinical RAG)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=

# Server Port (Default 8080, fallback 8081)
PORT=8080
