# ==============================================================================
# ApnaVaidya Production & Local Environment Configuration
# ==============================================================================

# --- Frontend API Connection ---
# Local development: Leave empty for automatic probing to http://localhost:8080/api
# Production (Vercel): Set to your Render Java backend URL (e.g. https://apna-vaidya-backend.onrender.com)
VITE_API_URL=

# --- Backend Database (PostgreSQL) ---
# Production: Render PostgreSQL or Supabase/Neon connection string
# Format: postgresql://username:password@host:5432/database_name
# Local: Leave empty to automatically use zero-config local JSON file storage (server/data/*.json)
DATABASE_URL=

# --- Cryptographic Security Keys ---
# Production: Set to strong, randomly generated 256-bit secret strings (e.g. openssl rand -base64 32)
# Required for signing HMAC-SHA256 JWT auth tokens
JWT_SECRET=

# Required for AES-256 GCM authenticated encryption at rest for patient records and PII
VAULT_ENCRYPTION_KEY=

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed frontend origins (no wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://apnavaidya.vercel.app

# --- AI & LLM Gateways (Optional) ---
# If left empty, ApnaVaidya automatically uses built-in ICMR Clinical RAG
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=

# --- Server Port ---
# Default 8080. Render automatically sets PORT in production.
PORT=8080
